# Скопируйте в .env рядом с api.py. API читает его при запуске.
# Системные переменные имеют приоритет. Ключи не добавляйте в Git.
# Без ключей подбор работает с локальными фактическими объяснениями.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Для NVIDIA измените LLM_PROVIDER на nvidia и заполните NVIDIA_API_KEY.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# DATASET_PATH=data/hackathon-dataset-anonymized.jsonl
